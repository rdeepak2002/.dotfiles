{
  "suggest.noselect": false,
  "coc.preferences.formatOnSaveFiletypes": [
    "javascript",
    "typescript",
    "typescriptreact",
    "json",
    "javascriptreact",
    "typescript.tsx",
    "graphql",
    "swift",
    "java"
  ],

  // Java (coc-java) Configuration
  "java.configuration.gradle.enabled": true,
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,
  "java.jdt.ls.java.home": "",
  "snippets.ultisnips.pythonPrompt": false,

  // Core fix: Enable automatic refresh of inlay hints
  "inlayHint.enable": true,
  "inlayHint.refreshOnInsertMode": true,

  // Python-specific inlay hints (coc-pyright) - DISABLED
  "pyright.inlayHints.variableTypes": false,
  "pyright.inlayHints.functionReturnTypes": false,
  "pyright.inlayHints.parameterTypes": false,

  // Swift Language Server Configuration
  "languageserver": {
    "sourcekit-lsp": {
      "command": "xcrun",
      "args": ["sourcekit-lsp"],
      "filetypes": ["swift"],
      "initializationOptions": {},
      "settings": {},
      "rootPatterns": ["Package.swift", ".git"]
    }
  }
}
